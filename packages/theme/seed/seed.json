							"subheadline": "Straightforward policies, fast shipping, and gear guaranteed for years — not seasons.",
							"features": [
								{
									"icon": "clock",
									"title": "Ships in 24 hours",
									"description": "Order by 2pm ET and your gear leaves our warehouse the same business day."
