---
import Base from "../layouts/Base.astro";

// Checkout, plugin-backed. Server re-prices from CMS truth; the client below
// is estimate + UX only. Providers: stripe (card), paypal, paymongo (GCash /
// GrabPay / cards), manual (transfer / COD).
---

<Base title="Checkout" description="Secure checkout — card, PayPal, GCash, or manual payment.">
	<section class="container section checkout">
		<nav class="steps" aria-label="Checkout progress">
			<a href="/cart">Cart</a>
			<span class="step-sep" aria-hidden="true">→</span>
			<span class="step-now" aria-current="step">Details</span>
			<span class="step-sep" aria-hidden="true">→</span>
			<span class="step-next">Done</span>
		</nav>

		<h1>Checkout</h1>
		<div id="cancelled-note" class="cancelled" hidden>
			Your payment was cancelled — nothing was charged. Your cart is intact.
		</div>

		<div class="checkout-layout">
			<form id="order-form" class="order-form" novalidate>
				<section class="form-card">
					<h2><span class="step-num">01</span> Contact</h2>
					<label>Email<input type="email" name="email" required autocomplete="email" placeholder="you@example.com" /></label>
					<div class="row">
						<label>First name<input type="text" name="first" required autocomplete="given-name" placeholder="Ada" /></label>
						<label>Last name<input type="text" name="last" required autocomplete="family-name" placeholder="Lovelace" /></label>
					</div>
				</section>

				<section class="form-card">
					<h2><span class="step-num">02</span> Shipping</h2>
					<label>Address<input type="text" name="address" required autocomplete="street-address" placeholder="Street and number" /></label>
					<div class="row">
						<label>City<input type="text" name="city" required autocomplete="address-level2" placeholder="City" /></label>
						<label>ZIP<input type="text" name="zip" required autocomplete="postal-code" placeholder="ZIP" /></label>
					</div>
					<label>
						Order notes (optional)
						<textarea name="notes" rows="2" placeholder="Delivery instructions, gift message…"></textarea>
					</label>
				</section>

				<section class="form-card">
					<h2><span class="step-num">03</span> Payment</h2>
					<div class="coupon-box">
						<label>
							Coupon code
							<div class="coupon-row">
								<input type="text" name="coupon" id="coupon-input" placeholder="WELCOME10" autocomplete="off" />
								<button type="button" class="btn btn-secondary" id="coupon-apply">Apply</button>
							</div>
						</label>
						<p class="coupon-msg" id="coupon-msg" aria-live="polite"></p>
					</div>

					<div class="pay-grid" role="radiogroup" aria-label="Payment method">
						<label class="pay-card" data-method="stripe">
							<input type="radio" name="provider" value="stripe" checked />
							<span class="pay-mark pay-stripe" aria-hidden="true">◆</span>
							<span class="pay-text"><strong>Card</strong><small>Visa · Mastercard · Amex via Stripe</small></span>
							<span class="pay-check" aria-hidden="true">✓</span>
						</label>
						<label class="pay-card" data-method="paypal">
							<input type="radio" name="provider" value="paypal" />
							<span class="pay-mark pay-paypal" aria-hidden="true">P</span>
							<span class="pay-text"><strong>PayPal</strong><small>Buyer protection included</small></span>
							<span class="pay-check" aria-hidden="true">✓</span>
						</label>
						<label class="pay-card" data-method="paymongo">
							<input type="radio" name="provider" value="paymongo" />
							<span class="pay-mark pay-paymongo" aria-hidden="true">G</span>
							<span class="pay-text"><strong>E-wallets</strong><small>GCash · GrabPay · cards via PayMongo</small></span>
							<span class="pay-check" aria-hidden="true">✓</span>
						</label>
						<label class="pay-card" data-method="manual">
							<input type="radio" name="provider" value="manual" />
							<span class="pay-mark pay-manual" aria-hidden="true">✉</span>
							<span class="pay-text"><strong>Manual</strong><small>Bank transfer / cash on delivery</small></span>
							<span class="pay-check" aria-hidden="true">✓</span>
						</label>
					</div>
				</section>

				<p class="form-error" id="form-error" role="alert" hidden></p>
				<button class="btn btn-primary btn-lg pay-submit" type="submit" id="pay-btn">Continue →</button>
				<p class="secure-note">🔒 Final totals confirmed server-side before payment.</p>
			</form>

			<aside class="summary">
				<h2>Order summary</h2>
				<div id="ship-progress"></div>
				<div id="summary-root"><p class="loading">Loading…</p></div>
				<ul class="trust">
					<li>🔒 Secure checkout</li>
					<li>↩ 60-day returns</li>
					<li>🛡 2-year warranty</li>
				</ul>
			</aside>
		</div>
	</section>
</Base>

<script is:inline>
document.addEventListener("DOMContentLoaded", function () {
	var summaryRoot = document.getElementById("summary-root");
	var shipBar = document.getElementById("ship-progress");
	var form = document.getElementById("order-form");
	var payBtn = document.getElementById("pay-btn");
	var errBox = document.getElementById("form-error");
	var couponInput = document.getElementById("coupon-input");
	var couponApply = document.getElementById("coupon-apply");
	var couponMsg = document.getElementById("coupon-msg");
	if (!summaryRoot || !form || !window.NWCart) return;
	var Cart = window.NWCart;
	var COUPON_KEY = "sella_coupon";
	var FREE_AT = 75;

	if (new URLSearchParams(location.search).get("cancelled") === "1") {
		var note = document.getElementById("cancelled-note");
		if (note) note.removeAttribute("hidden");
	}

	function esc(s) {
		return String(s).replace(/[&<>"]/g, function (c) {
			return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c];
		});
	}
	function getCoupon() {
		try {
			return JSON.parse(localStorage.getItem(COUPON_KEY)) || null;
		} catch (e) {
			return null;
		}
	}
	function money(n) {
		return "$" + Number(n).toFixed(2);
	}
	function provider() {
		var el = form.querySelector('input[name="provider"]:checked');
		return (el && el.value) || "stripe";
	}
	// Client-side estimate only — the server re-prices everything.
	function estimate() {
		var items = Cart.items();
		var subtotal = items.reduce(function (n, i) {
			return n + i.price * i.qty;
		}, 0);
		var coupon = getCoupon();
		var discount = 0;
		if (coupon) {
			discount =
				coupon.kind === "percent"
					? Math.min(subtotal, (subtotal * coupon.value) / 100)
					: Math.min(subtotal, coupon.value);
		}
		var shipping = items.length === 0 ? 0 : subtotal - discount >= FREE_AT ? 0 : 6.95;
		return { items: items, subtotal: subtotal, discount: discount, shipping: shipping, total: subtotal - discount + shipping };
	}

	function thumb(i) {
		if (i.image) return '<img class="sum-thumb" src="' + esc(i.image) + '" alt="" loading="lazy" />';
		var initial = esc((i.name || "?").charAt(0).toUpperCase());
		return '<span class="sum-thumb sum-thumb-fallback" aria-hidden="true">' + initial + "</span>";
	}

	function renderSummary() {
		var e = estimate();
		if (e.items.length === 0) {
			summaryRoot.innerHTML = '<p>Your cart is empty. <a href="/shop">Shop the collection →</a></p>';
			shipBar.innerHTML = "";
			updatePayBtn(e);
			return;
		}
		var rows = e.items
			.map(function (i) {
				return (
					'<div class="sum-row sum-item">' +
					thumb(i) +
					'<span class="sum-name">' +
					esc(i.name) +
					' <span class="sum-qty">× ' +
					i.qty +
					"</span></span><strong>" +
					money(i.price * i.qty) +
					"</strong></div>"
				);
			})
			.join("");
		summaryRoot.innerHTML =
			rows +
			'<div class="sum-row"><span>Subtotal</span><strong>' +
			money(e.subtotal) +
			"</strong></div>" +
			(e.discount > 0
				? '<div class="sum-row discount"><span>Discount</span><strong>−' + money(e.discount) + "</strong></div>"
				: "") +
			'<div class="sum-row"><span>Shipping</span><strong>' +
			(e.shipping === 0 ? "Free" : money(e.shipping)) +
			"</strong></div>" +
			'<div class="sum-total"><span>Total</span><strong>' +
			money(e.total) +
			"</strong></div>";
		var toGo = Math.max(0, FREE_AT - (e.subtotal - e.discount));
		shipBar.innerHTML =
			'<div class="ship-bar">' +
			(toGo > 0
				? "<p>Add <strong>" + money(toGo) + "</strong> for free shipping</p>"
				: "<p>🎉 Free shipping unlocked</p>") +
			'<div class="ship-track"><div class="ship-fill" style="width:' +
			Math.min(100, Math.round(((e.subtotal - e.discount) / FREE_AT) * 100)) +
			'%"></div></div></div>';
		updatePayBtn(e);
	}

	var PAY_LABELS = {
		stripe: "Pay",
		paypal: "Continue with PayPal",
		paymongo: "Continue to e-wallets",
		manual: "Place order",
	};
	function updatePayBtn(e) {
		e = e || estimate();
		var p = provider();
		if (p === "stripe") payBtn.textContent = e.items.length ? "Pay " + money(e.total) + " →" : "Continue →";
		else payBtn.textContent = PAY_LABELS[p] || "Continue →";
	}

	function showError(msg) {
		errBox.textContent = msg;
		errBox.removeAttribute("hidden");
		errBox.scrollIntoView({ behavior: "smooth", block: "center" });
		payBtn.removeAttribute("disabled");
		updatePayBtn();
	}

	form.addEventListener("change", function (ev) {
		if (ev.target && ev.target.name === "provider") updatePayBtn();
	});

	if (couponApply) {
		couponApply.addEventListener("click", function () {
			var code = couponInput.value.trim();
			if (!code) return;
			couponMsg.textContent = "Checking…";
			couponMsg.className = "coupon-msg";
			var e = estimate();
			fetch("/_emdash/api/plugins/sella/coupons/validate", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ code: code, subtotal: e.subtotal }),
			})
				.then(function (r) {
					return r.json();
				})
				.then(function (j) {
					j = (j && j.data) || j;
					if (j.valid) {
						localStorage.setItem(COUPON_KEY, JSON.stringify({ code: j.code, kind: j.kind, value: j.value }));
						couponMsg.textContent = "✓ " + j.code + " applied — " + j.discountLabel + " off.";
						couponMsg.className = "coupon-msg ok";
					} else {
						localStorage.removeItem(COUPON_KEY);
						couponMsg.textContent = j.reason || "Invalid code.";
						couponMsg.className = "coupon-msg bad";
					}
					renderSummary();
				})
				.catch(function () {
					couponMsg.textContent = "Couldn't check that code — try again.";
					couponMsg.className = "coupon-msg bad";
				});
		});
	}
	var saved = getCoupon();
	if (saved && couponInput) couponInput.value = saved.code || "";

	form.addEventListener("submit", function (ev) {
		ev.preventDefault();
		errBox.setAttribute("hidden", "");
		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}
		var items = Cart.items();
		if (items.length === 0) {
			showError("Your cart is empty.");
			return;
		}
		payBtn.setAttribute("disabled", "");
		payBtn.textContent = "Creating secure checkout…";
		var data = new FormData(form);
		var coupon = getCoupon();
		fetch("/_emdash/api/plugins/sella/checkout", {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({
				provider: provider(),
				email: data.get("email"),
				name: ((data.get("first") || "") + " " + (data.get("last") || "")).trim(),
				items: items.map(function (i) {
					return { slug: i.id, qty: i.qty };
				}),
				coupon: coupon ? coupon.code : "",
				address: {
					line1: data.get("address"),
					city: data.get("city"),
					zip: data.get("zip"),
				},
				notes: data.get("notes"),
			}),
		})
			.then(function (r) {
				return r.json().then(function (j) {
					return { status: r.status, body: j };
				});
			})
			.then(function (res) {
				var body = (res.body && res.body.data) || res.body || {};
				if (body.url) {
					if (body.problems && body.problems.length) {
						alert(body.problems.join("\n"));
					}
					try {
						localStorage.setItem("sella_email", String(data.get("email") || ""));
					} catch (e) {}
					window.location.href = body.url;
					return;
				}
				if (body.instructions && body.orderNumber) {
					try {
						localStorage.setItem("sella_email", String(data.get("email") || ""));
						localStorage.removeItem("sella_coupon");
					} catch (e) {}
					window.location.href = "/thank-you?order=" + encodeURIComponent(body.orderNumber);
					return;
				}
				showError((body.error && body.error.message) || "Checkout failed. Try again.");
			})
			.catch(function () {
				showError("Couldn't reach checkout. Check your connection and try again.");
			});
	});

	document.addEventListener("nw:cart-updated", renderSummary);
	renderSummary();
});
</script>

<style>
	.checkout h1 {
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: -0.02em;
		margin-bottom: var(--spacing-xs);
	}

	.steps {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-lg);
		font-size: var(--font-size-sm);
		font-weight: 600;
	}

	.steps a {
		color: var(--color-brand);
	}

	.step-sep {
		color: var(--color-border);
	}

	.step-now {
		color: var(--color-text);
		border-bottom: 2px solid var(--color-brand);
		padding-bottom: 2px;
	}

	.step-next {
		color: var(--color-muted);
	}

	.cancelled {
		margin-bottom: var(--spacing-xl);
		padding: var(--spacing-md) var(--spacing-lg);
		font-size: var(--font-size-sm);
		background: var(--color-surface);
		border: 1px solid var(--color-warning);
		border-radius: var(--radius);
	}

	.checkout-layout {
		display: grid;
		grid-template-columns: 1fr 380px;
		gap: var(--spacing-2xl);
		margin-top: var(--spacing-xl);
		align-items: start;
	}

	.order-form {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xl);
		min-width: 0;
	}

	.form-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		box-shadow: var(--shadow-sm);
	}

	.form-card h2 {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-family: var(--font-display);
		font-size: var(--font-size-xl);
		margin: 0 0 var(--spacing-xs);
	}

	.step-num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		font-family: var(--font-body);
		font-size: var(--font-size-xs);
		font-weight: 800;
		color: var(--color-on-brand);
		background: var(--color-text);
		border-radius: var(--radius-full);
	}

	.order-form label {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: var(--font-size-sm);
		font-weight: 600;
	}

	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-md);
	}

	.order-form input[type="email"],
	.order-form input[type="text"],
	.order-form input[type="number"],
	.order-form textarea {
		padding: 12px 14px;
		font: inherit;
		font-weight: 400;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1.5px solid var(--color-border);
		border-radius: var(--radius);
		transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
	}

	.order-form input:focus,
	.order-form textarea:focus {
		outline: none;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.coupon-box {
		padding: var(--spacing-md);
		background: var(--color-bg);
		border: 1px dashed var(--color-border);
		border-radius: var(--radius);
	}

	.coupon-row {
		display: flex;
		gap: var(--spacing-sm);
	}

	.coupon-row input {
		flex: 1;
		text-transform: uppercase;
	}

	.coupon-msg {
		margin-top: var(--spacing-xs);
		margin-bottom: 0;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.coupon-msg.ok {
		color: var(--color-success);
	}

	.coupon-msg.bad {
		color: var(--color-danger);
	}

	.pay-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-sm);
		border: none;
		padding: 0;
		margin: 0;
	}

	.pay-card {
		position: relative;
		display: flex !important;
		align-items: center;
		gap: var(--spacing-sm);
		padding: var(--spacing-md);
		border: 1.5px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-bg);
		cursor: pointer;
		transition: border-color var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast);
	}

	.pay-card:hover {
		border-color: var(--color-muted);
		transform: translateY(-1px);
	}

	.pay-card input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.pay-card:has(input:checked) {
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.pay-card:has(input:focus-visible) {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}

	.pay-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		flex-shrink: 0;
		border-radius: 12px;
		font-weight: 900;
		font-size: 18px;
		color: #fff;
	}

	.pay-stripe {
		background: linear-gradient(135deg, #635bff, #3d2fe0);
	}

	.pay-paypal {
		background: linear-gradient(135deg, #003087, #0079c1);
		font-style: italic;
	}

	.pay-paymongo {
		background: linear-gradient(135deg, #0f9d58, #0277bd);
	}

	.pay-manual {
		background: var(--color-text);
	}

	.pay-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		font-size: var(--font-size-sm);
	}

	.pay-text small {
		color: var(--color-muted);
		font-weight: 400;
	}

	.pay-check {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		border-radius: var(--radius-full);
		background: var(--color-brand);
		color: var(--color-on-brand);
		font-size: 12px;
		font-weight: 800;
		opacity: 0;
		transform: scale(0.6);
		transition: opacity var(--transition-fast), transform var(--transition-fast);
	}

	.pay-card:has(input:checked) .pay-check {
		opacity: 1;
		transform: scale(1);
	}

	.form-error {
		padding: var(--spacing-md);
		font-size: var(--font-size-sm);
		color: var(--color-danger);
		background: color-mix(in srgb, var(--color-danger) 8%, transparent);
		border: 1px solid var(--color-danger);
		border-radius: var(--radius);
	}

	.pay-submit {
		width: 100%;
		padding: 16px;
		font-size: var(--font-size-lg);
		border-radius: var(--radius-full);
	}

	.secure-note {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-align: center;
		margin: 0;
	}

	.summary {
		padding: var(--spacing-xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		position: sticky;
		top: 90px;
		box-shadow: var(--shadow-sm);
	}

	.summary h2 {
		font-family: var(--font-display);
		font-size: var(--font-size-xl);
		margin: 0 0 var(--spacing-md);
	}

	.ship-bar {
		margin-bottom: var(--spacing-md);
		padding: var(--spacing-md);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.ship-bar p {
		font-size: var(--font-size-sm);
		margin: 0 0 var(--spacing-sm);
	}

	.ship-track {
		height: 8px;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		overflow: hidden;
	}

	.ship-fill {
		height: 100%;
		background: var(--gradient-brand-strong);
		transition: width 0.3s ease;
	}

	.sum-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-sm) 0;
		font-size: var(--font-size-sm);
		border-bottom: 1px solid var(--color-border);
	}

	.sum-item {
		padding: var(--spacing-sm) 0;
	}

	.sum-thumb {
		width: 48px;
		height: 48px;
		flex-shrink: 0;
		object-fit: cover;
		border-radius: var(--radius-sm);
	}

