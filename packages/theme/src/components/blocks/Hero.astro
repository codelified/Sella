---
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type HeroBlock = Extract<PageContentBlock, { _type: "marketing_hero" }>;
type Props = BlockComponentProps<HeroBlock>;

const { value } = Astro.props;
const { anchor_id, headline, subheadline, image, centered } = value;

const primaryCta =
	value.primary_cta_label && value.primary_cta_url
		? { label: value.primary_cta_label, url: sanitizeHref(value.primary_cta_url) }
		: undefined;
const secondaryCta =
	value.secondary_cta_label && value.secondary_cta_url
		? { label: value.secondary_cta_label, url: sanitizeHref(value.secondary_cta_url) }
		: undefined;
---

<section
	id={anchor_id || undefined}
	class:list={["hero", { "hero-centered": centered, "hero-with-image": !!image }]}
>
	<div class="hero-content">
		<p class="hero-eyebrow">Northwind Supply Co. — Est. goods for the long trail</p>
		<h1 class="hero-headline">{headline}</h1>
		{subheadline && <p class="hero-subheadline">{subheadline}</p>}
		{(primaryCta || secondaryCta) && (
			<div class="hero-actions">
				{primaryCta && (
					<a href={primaryCta.url} class="btn btn-primary btn-lg">
						{primaryCta.label}
					</a>
				)}
				{secondaryCta && (
					<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
						{secondaryCta.label}
					</a>
				)}
			</div>
		)}
	</div>
		{image ? (
			<div class="hero-image">
				<Image image={image} class="hero-image-media" priority />
		</div>
	) : !centered && (
		<div class="hero-visual" aria-hidden="true">
			<img src="/hero-visual.svg" alt="" width="800" height="800" />
		</div>
	)}
</section>

<style>
	.hero {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-4xl) var(--spacing-lg);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-2xl);
		align-items: center;
	}

	.hero-centered {
		grid-template-columns: 1fr;
		text-align: center;
		max-width: var(--max-width);
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-xl);
	}

	.hero-centered .hero-content {
		max-width: 100%;
	}

	.hero-centered .hero-actions {
		justify-content: center;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
		max-width: 600px;
	}

	.hero-eyebrow {
		font-size: var(--font-size-xs);
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-brand);
	}

	.hero-headline {
		font-family: var(--font-display);
		font-size: var(--font-size-6xl);
		font-weight: 600;
		line-height: 1.02;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.hero-subheadline {
		font-size: var(--font-size-xl);
		line-height: var(--leading-normal);
		color: var(--color-muted);
	}

	.hero-actions {
		display: flex;
		gap: var(--spacing-md);
		flex-wrap: wrap;
	}

	.hero-image {
		position: relative;
	}

	.hero-image :global(.hero-image-media) {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
		box-shadow: var(--shadow-xl);
	}

	.hero-image::before {
		content: "";
		position: absolute;
		inset: 24px -12px -12px 24px;
		background: var(--gradient-brand-soft);
		border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
		z-index: -1;
		opacity: 0.5;
	}

	.hero-image::after {
		content: "★ field-tested ★";
		position: absolute;
		bottom: 32px;
		left: -16px;
		padding: 8px 18px;
		font-size: var(--font-size-xs);
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-on-brand);
		background: var(--color-text);
		border-radius: var(--radius-full);
		transform: rotate(-6deg);
		box-shadow: var(--shadow-lg);
	}

	/* Hero visual (external SVG image) */
	.hero-visual {
		position: relative;
		width: 100%;
		max-width: 480px;
		justify-self: center;
	}

	.hero-visual img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
		background: var(--gradient-brand-soft);
	}

	@media (max-width: 1024px) {
		.hero {
			grid-template-columns: 1fr;
			padding: var(--spacing-2xl) var(--spacing-lg);
			gap: var(--spacing-2xl);
		}

		.hero-headline {
			font-size: var(--font-size-4xl);
		}

		.hero-with-image {
			text-align: center;
		}

		.hero-with-image .hero-actions {
			justify-content: center;
		}

		.hero-image,
		.hero-visual {
			order: -1;
		}
	}
</style>
