---
/**
 * Editorial layout — product detail.
 *
 * Structurally different from the default layout: the image is full-bleed on
 * one side, the title is oversized, and the buy panel is sticky. Reads like a
 * product spread rather than a two-column spec sheet.
 *
 * Commerce behaviour lives in the shared components — this file owns layout
 * and markup only. See the template contract in docs/theme-integration.md.
 */
import { getEmDashEntry } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import AddToCart from "../../components/AddToCart.astro";
import Reviews from "../../components/Reviews.astro";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);
if (!product) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const data: any = product.data;
const stock = typeof data.stock === "number" ? data.stock : null;
const soldOut = stock !== null && stock <= 0;
---

<Base title={data.name} description={data.short_description ?? data.name}>
	<article class="ed-product">
		<div class="ed-product-media">
			{data.image ? (
				<Image image={data.image} alt={data.name} />
			) : (
				<div class="ed-media-fallback" aria-hidden="true" />
			)}
		</div>

		<div class="ed-product-panel">
			<p class="ed-eyebrow">${Number(data.price).toFixed(2)}</p>
			<h1 class="ed-product-title">{data.name}</h1>
			{data.short_description && <p class="ed-product-desc">{data.short_description}</p>}

			{stock !== null && (
				<p class="ed-stock">{stock > 0 ? `${stock} in stock` : "Sold out"}</p>
			)}

			<AddToCart id={product.id} name={data.name} price={data.price} soldOut={soldOut} />

			<Reviews slug={product.id} />
		</div>
	</article>
</Base>

<style>
	.ed-product {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: 3rem;
		align-items: start;
		min-height: 70vh;
	}

	.ed-product-media {
		position: sticky;
		top: 0;
		min-height: 70vh;
		background: var(--color-surface);
		overflow: hidden;
	}

	.ed-product-media :global(img) {
		width: 100%;
		height: 100vh;
		object-fit: cover;
	}

	.ed-product-panel {
		padding: 5rem 3rem 5rem 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.ed-product-title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(2.25rem, 5vw, 4rem);
		line-height: 1.02;
		letter-spacing: -0.03em;
	}

	.ed-product-desc {
		color: var(--color-muted);
		max-width: 42ch;
		margin: 0;
	}

	.ed-stock {
		margin: 0;
		font-size: 0.9rem;
		color: var(--color-muted);
	}

	@media (max-width: 860px) {
		.ed-product {
			grid-template-columns: 1fr;
		}

		.ed-product-media {
			position: static;
			min-height: 0;
			aspect-ratio: 4 / 3;
		}

		.ed-product-media :global(img) {
			height: auto;
		}

		.ed-product-panel {
			padding: 2rem 1.25rem 4rem;
		}
	}
</style>