{
	"$comment": "Manifest consumed by @sella/create. Lists what the CLI overlays onto a stock EmDash marketing template (node platform).",
	"base": {
		"template": "marketing",
		"platform": "node",
		"emdash": "^1.0.1"
	},
	"core": "^0.2.0",
	"copy": [
		"seed/seed.json",
		"src/pages/",
		"src/components/",
		"src/layouts/",
		"src/lib/",
		"src/styles/theme.css",
		"public/fonts/",
		"src/styles/fonts.css",
		"public/cart.js",
		"public/patterns/",
		".env.example"
	],
	"config": "astro.config.mjs",
	"deps": {
		"@sella/core": "^0.2.0"
	},
	"layouts": {
		"catalog": [],
		"editorial": [
			"src/pages/shop/index.astro",
			"src/pages/shop/[slug].astro",
			"src/styles/editorial.css"
		]
	},
	"overrides": {
		"modern-tar": "0.7.7"
	},
	"compatibleCore": ">=0.2.0 <0.3.0"
}
