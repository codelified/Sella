{
	"name": "@sella/core",
	"version": "0.2.0",
	"description": "Shopify-like commerce for EmDash CMS — native plugin",
	"type": "module",
	"main": "./dist/index.mjs",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./admin": "./src/admin/index.tsx"
	},
	"files": ["dist", "src/admin", "README.md"],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts --clean",
		"dev": "tsdown src/index.ts --format esm --dts --watch",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"emdash": "^1.0.1",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"emdash": "^1.0.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tsdown": "^0.20.0",
		"typescript": "^5.9.0"
	},
	"license": "MIT"
}
