---
// Product detail. Per docs/theme-integration.md §2: "Product detail | CMS query
// + GET reviews/list?productSlug=&limit + GET reviews/summary?productSlug=".
import { getEmDashEntry } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);
if (!product) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const data: any = product.data;
const stock = typeof data.stock === "number" ? data.stock : null;
const soldOut = stock !== null && stock <= 0;

// Reviews live in the commerce layer. Both calls are best-effort: a store with
// no reviews still renders.
const [reviewsRes, summaryRes] = await Promise.all([
	fetch(`${Astro.url.origin}/_emdash/api/plugins/sella/reviews/list?productSlug=${slug}&limit=10`)
		.then((r) => r.json())
		.catch(() => null),
	fetch(`${Astro.url.origin}/_emdash/api/plugins/sella/reviews/summary?productSlug=${slug}`)
		.then((r) => r.json())
		.catch(() => null),
]);
const reviews: any[] = (reviewsRes as any)?.items ?? [];
const reviewCount = (summaryRes as any)?.count ?? 0;
const avgRating = (summaryRes as any)?.average ?? 0;
---

<Base title={data.name} description={data.short_description ?? data.name}>
	<article class="container section product">
		<div class="media">
			{data.image ? <Image image={data.image} alt={data.name} /> : <div class="thumb" aria-hidden="true" />}
		</div>
		<div class="details">
			<h1>{data.name}</h1>
			<p class="price">${Number(data.price).toFixed(2)}</p>
			{data.short_description && <p>{data.short_description}</p>}
			{stock !== null && (
				<p class="stock">{stock > 0 ? `${stock} in stock` : "Sold out"}</p>
			)}

			{/* Cart is theme-local state (localStorage). Nothing to call. */}
			<form id="atc">
				<input type="number" name="qty" value="1" min="1" max="99" aria-label="Quantity" />
				<button type="submit" disabled={soldOut}>
					{soldOut ? "Sold out" : "Add to cart"}
				</button>
			</form>
			<p id="atc-note" hidden>Added to cart.</p>

			<section class="reviews" id="reviews">
				<h2>Reviews ({reviewCount})</h2>
				{avgRating > 0 && <p class="avg">Average rating: {avgRating}</p>}
				{reviews.length === 0 ? (
					<p>No reviews yet.</p>
				) : (
					<ul>
						{reviews.map((r: any) => (
							<li>
								<strong>{r.title ?? r.author}</strong> — {r.rating}/5
								<p>{r.body}</p>
							</li>
						))}
					</ul>
				)}

				<form id="review-form">
					<input name="author" placeholder="Your name" required />
					<input name="rating" type="number" min="1" max="5" placeholder="Rating 1-5" required />
					<textarea name="body" placeholder="What did you think?" required></textarea>
					<button type="submit">Post review</button>
				</form>
				<p id="review-msg" hidden></p>
			</section>
		</div>
	</article>
</Base>

<script is:inline define:vars={{ slug: product.id, name: data.name, price: data.price }}>
	// Minimal localStorage cart, as the contract allows ("none (localStorage is fine)").
	function cart() {
		try {
			return JSON.parse(localStorage.getItem("cart") || "{}");
		} catch {
			return {};
		}
	}
	function save(c) {
		localStorage.setItem("cart", JSON.stringify(c));
	}
	document.addEventListener("DOMContentLoaded", function () {
		var form = document.getElementById("atc");
		if (form) {
			form.addEventListener("submit", function (e) {
				e.preventDefault();
				var qty = Math.max(1, parseInt(form.querySelector('[name="qty"]').value, 10) || 1);
				var c = cart();
				c[slug] = { slug: slug, name: name, price: price, qty: (c[slug]?.qty || 0) + qty };
				save(c);
				document.getElementById("atc-note")?.removeAttribute("hidden");
			});
		}
		var rf = document.getElementById("review-form");
		if (rf) {
			rf.addEventListener("submit", async function (e) {
				e.preventDefault();
				var msg = document.getElementById("review-msg");
				var fd = new FormData(rf);
				var res = await fetch("/_emdash/api/plugins/sella/reviews/submit", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({
						productSlug: slug,
						author: fd.get("author"),
						rating: Number(fd.get("rating")),
						body: fd.get("body"),
					}),
				}).catch(() => null);
				var out = await res?.json().catch(() => null);
				if (msg) {
					msg.hidden = false;
					var d = out?.data;
					msg.textContent = d?.received
						? d.moderated
							? "Thanks — your review is awaiting moderation."
							: "Thanks — your review is live."
						: d?.error?.message || "Could not submit the review.";
				}
			});
		}
	});
</script>

<style>
	.product {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5rem;
		align-items: start;
	}
	.thumb {
		aspect-ratio: 4 / 3;
		background: var(--color-surface, #eee);
		border-radius: 8px;
	}
	.price {
		font-size: 1.4rem;
		font-weight: 700;
	}
	#atc {
		display: flex;
		gap: 0.5rem;
		margin: 1rem 0;
	}
	#atc input {
		width: 5rem;
		padding: 0.5rem;
	}
	.reviews {
		border-top: 1px solid var(--color-border, #ddd);
		margin-top: 2rem;
		padding-top: 1.5rem;
	}
	@media (max-width: 700px) {
		.product {
			grid-template-columns: 1fr;
		}
	}
</style>